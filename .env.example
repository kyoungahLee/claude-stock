# ============================================================
# LLM Provider 선택: "anthropic" 또는 "bedrock"
# ============================================================
LLM_PROVIDER=anthropic

# ============================================================
# Option 1: Anthropic Direct API (LLM_PROVIDER=anthropic)
# ============================================================
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ============================================================
# Option 2: AWS Bedrock (LLM_PROVIDER=bedrock)
# ============================================================
# 방법 A: AWS Profile 사용 (~/.aws/credentials에 설정된 프로필)
AWS_PROFILE=default
AWS_REGION=us-east-1

# 방법 B: Access Key 직접 입력
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...  (임시 자격증명 사용 시)

# Bedrock 모델 ID (기본값: Claude Sonnet 4)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# ============================================================
# Slack Notifications (선택)
# ============================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# ============================================================
# Email Notifications (선택)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_RECIPIENTS=recipient@example.com

# ============================================================
# Database (선택 - 기본값: SQLite)
# ============================================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/stock_forecast

# ============================================================
# Analysis depth: light | standard | deep
# ============================================================
ANALYSIS_DEPTH=standard
